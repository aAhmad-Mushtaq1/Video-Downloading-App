#include <windows.h>

IDI_APP_ICON ICON "resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "com.videodownloader.app"
            VALUE "FileDescription", "Video Downloader"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "video_downloader"
            VALUE "LegalCopyright", "Copyright (C) 2024"
            VALUE "OriginalFilename", "video_downloader.exe"
            VALUE "ProductName", "Video Downloader"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
